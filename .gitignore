logs/
*.log
*.jsonl

# Local secrets or credentials
.env
.env.*
!.env.example
*.pem
*.key

# Local editor or Claude session data (keep shared config)
.vscode/*.code-workspace
.claude/settings.local.json
CLAUDE.local.md

# OS
.DS_Store
Thumbs.db
